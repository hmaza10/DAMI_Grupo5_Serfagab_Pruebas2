<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/negro_navbar">

        <ImageView
            android:id="@+id/btnMenu"
            android:contentDescription="@string/abrir_menu"
            android:layout_width="@dimen/menu_icon_dimen"
            android:layout_height="@dimen/menu_icon_dimen"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />


        <TextView
            android:id="@+id/textViewUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/bienvenida_predeterminada"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sidebarContainer"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/negro_navbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/magin_bottom"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="10dp">

                <ImageView
                    android:layout_width="@dimen/dimen_image"
                    android:layout_height="@dimen/dimen_image"
                    android:src="@drawable/ic_logo_cube"
                    app:tint="@color/naranja" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/name_empresa"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <include layout="@layout/item_sidebar_inicio"/>
            <include layout="@layout/item_sidebar_materiales"/>
            <include layout="@layout/item_sidebar_tipomaterial"/>
            <include layout="@layout/item_sidebar_proveedores"/>
            <include layout="@layout/item_sidebar_ordencompra"/>

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>

    </LinearLayout>

</LinearLayout>